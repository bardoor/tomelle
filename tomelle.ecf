<?xml version="1.0" encoding="UTF-8"?>
<system xmlns="http://www.eiffel.com/developers/xml/configuration-1-22-0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.eiffel.com/developers/xml/configuration-1-22-0 http://www.eiffel.com/developers/xml/configuration-1-22-0.xsd" name="tomelle" uuid="c5dfeb38-9acf-4379-93ca-40aebb677070" library_target="tomelle">
  <target name="tomelle">
    <root all_classes="true"/>
    <option warning="warning" full_class_checking="true">
      <assertions precondition="true" postcondition="true" check="true" invariant="true" loop="true" supplier_precondition="true"/>
    </option>
    <capability>
      <catcall_detection support="none"/>
      <concurrency support="none" use="none"/>
      <void_safety support="all"/>
    </capability>
    <library name="base" location="$ISE_LIBRARY/library/base/base.ecf" readonly="true">
      <condition>
        <custom name="GOBO_EIFFEL" excluded_value="ge"/>
      </condition>
    </library>
    <library name="free_elks" location="$GOBO/library/free_elks/library_ge.ecf" readonly="true">
      <condition>
        <custom name="GOBO_EIFFEL" value="ge"/>
      </condition>
    </library>
    <cluster name="model_values" location="./src/model/values">
      <visible class="TOMELLE_VALUE"/>
      <visible class="TOMELLE_FLOAT_CODEC"/>
      <visible class="TOMELLE_STRING"/>
      <visible class="TOMELLE_INTEGER"/>
      <visible class="TOMELLE_FLOAT"/>
      <visible class="TOMELLE_BOOLEAN"/>
      <visible class="TOMELLE_OFFSET_DATE_TIME_VALUE"/>
      <visible class="TOMELLE_LOCAL_DATE_TIME_VALUE"/>
      <visible class="TOMELLE_LOCAL_DATE_VALUE"/>
      <visible class="TOMELLE_LOCAL_TIME_VALUE"/>
    </cluster>
    <cluster name="model_items" location="./src/model/items">
      <visible class="TOMELLE_ITEM"/>
      <visible class="TOMELLE_TRIVIA"/>
      <visible class="TOMELLE_KEY"/>
      <visible class="TOMELLE_ENTRY"/>
      <visible class="TOMELLE_COMMENT"/>
      <visible class="TOMELLE_WHITESPACE"/>
      <visible class="TOMELLE_HEADER"/>
    </cluster>
    <cluster name="model_collections" location="./src/model/collections">
      <visible class="TOMELLE_DOCUMENT"/>
      <visible class="TOMELLE_ARRAY"/>
      <visible class="TOMELLE_TABLE"/>
    </cluster>
    <cluster name="model_time" location="./src/model/time">
      <visible class="TOMELLE_LOCAL_DATE"/>
      <visible class="TOMELLE_LOCAL_TIME"/>
      <visible class="TOMELLE_LOCAL_DATE_TIME"/>
      <visible class="TOMELLE_OFFSET_DATE_TIME"/>
    </cluster>
    <cluster name="model_paths" location="./src/model/paths">
      <visible class="TOMELLE_PATH"/>
      <visible class="TOMELLE_KEY_SYNTAX"/>
    </cluster>
    <cluster name="parsing" location="./src/parsing">
      <visible class="TOMELLE_PARSER"/>
      <visible class="TOMELLE_PARSE_RESULT"/>
    </cluster>
    <cluster name="serialization" location="./src/serialization">
      <visible class="TOMELLE_WRITER"/>
    </cluster>
    <cluster name="errors" location="./src/errors">
      <visible class="TOMELLE_ERROR_CODE"/>
      <visible class="TOMELLE_PARSE_ERROR"/>
      <visible class="TOMELLE_WRITE_ERROR"/>
      <visible class="TOMELLE_SOURCE_POSITION"/>
    </cluster>
  </target>
</system>
